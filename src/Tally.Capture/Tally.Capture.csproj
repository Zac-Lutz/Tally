<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is referenced only for System.Windows.Automation (BrowserUrlReader) — the managed
         UI Automation client. The self-contained publish already ships the desktop runtime, so
         this costs nothing at distribution time. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Tally.Capture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tally.Core\Tally.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
